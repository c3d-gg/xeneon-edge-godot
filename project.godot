; Engine configuration file.

config_version=5

[application]

config/name="Touch Focus Test"
config/description="Checks whether tapping a window on the Xeneon Edge steals focus from games or moves the mouse cursor."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=2560
window/size/viewport_height=720
window/size/borderless=true
window/size/always_on_top=true
window/size/no_focus=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
